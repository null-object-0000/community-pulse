      "milestone": null,
      "comments": 0,
      "created_at": "2026-05-15T08:11:22Z",
      "updated_at": "2026-06-12T09:54:10Z",
      "closed_at": "2026-06-12T09:54:10Z",
      "assignee": null,
      "author_association": "NONE",
      "active_lock_reason": null,
      "sub_issues_summary": {
