      "milestone": null,
      "comments": 0,
      "created_at": "2026-04-29T10:59:17Z",
      "updated_at": "2026-04-29T10:59:17Z",
      "closed_at": null,
      "assignee": null,
      "author_association": "NONE",
      "active_lock_reason": null,
      "sub_issues_summary": {
